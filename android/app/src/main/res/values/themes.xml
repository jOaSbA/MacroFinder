<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window before Compose draws. Paper, so launch doesn't flash white. -->
    <style name="Theme.MacroFinder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
